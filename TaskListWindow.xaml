<Window x:Class="CybersecurityAwarenessBot.GUI.TaskListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Security Task Manager"
        Height="680"
        Width="900"
        MinHeight="580"
        MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#080E1A"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#1B2940"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#34445F"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#34D399"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#26364D"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#34D399"/>
            <Setter Property="Foreground" Value="#08111F"/>
            <Setter Property="BorderBrush" Value="#34D399"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#172338"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="CaretBrush" Value="#34D399"/>
            <Setter Property="BorderBrush" Value="#34445F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="CYBERSECURITY / PERSONAL TASKS"
                           Foreground="#34D399"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Security Task Manager"
                           Foreground="#F1F5F9"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Build safer online habits one task at a time."
                           Foreground="#94A3B8"
                           FontSize="13"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#15352F"
                    CornerRadius="10"
                    Padding="13,10"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="#34D399"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <TextBlock Text="SYSTEM ONLINE"
                               Foreground="#34D399"
                               FontSize="10"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ADD TASK -->
        <Border Grid.Row="1"
                Background="#101A2B"
                BorderBrush="#26364D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="CREATE A SECURITY TASK"
                           Foreground="#94A3B8"
                           FontSize="10"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TaskInput"
                             Grid.Column="0"
                             Height="44"
                             VerticalContentAlignment="Center"
                             ToolTip="Enter a cybersecurity task"/>

                    <Button Grid.Column="1"
                            Content="+  ADD TASK"
                            Click="AddTaskButton_Click"
                            Margin="10,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- TASK LIST -->
        <Border Grid.Row="2"
                Background="#101A2B"
                BorderBrush="#26364D"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">

            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top"
                      Margin="0,0,0,15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="MY SECURITY CHECKLIST"
                                   Foreground="#F1F5F9"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Select a checkbox when you complete a task."
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#172338"
                            CornerRadius="7"
                            Padding="10,7"
                            VerticalAlignment="Center">

                        <TextBlock Text="TASKS"
                                   Foreground="#34D399"
                                   FontSize="10"
                                   FontWeight="Bold"/>
                    </Border>
                </Grid>

                <ListBox x:Name="TaskList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F1F5F9"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#172338"
                                    BorderBrush="#26364D"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="14"
                                    Margin="0,4">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,13,0"
                                              Checked="TaskCheckBox_Changed"
                                              Unchecked="TaskCheckBox_Changed"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Description}"
                                               Foreground="#F1F5F9"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- PROGRESS -->
        <Border Grid.Row="3"
                Background="#101A2B"
                BorderBrush="#26364D"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,16,0,14">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#15352F"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,12,0">

                    <TextBlock Text="✓"
                               Foreground="#34D399"
                               FontSize="17"
                               FontWeight="Bold"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="YOUR PROGRESS"
                               Foreground="#94A3B8"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>

                    <TextBlock x:Name="ProgressText"
                               Text="Completed: 0 of 0 tasks"
                               Foreground="#34D399"
                               FontSize="14"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ACTION BUTTONS -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button Content="REMOVE SELECTED"
                        Click="RemoveTaskButton_Click"
                        Style="{StaticResource ActionButtonStyle}"/>

                <Button Content="CLEAR COMPLETED"
                        Click="ClearCompletedButton_Click"
                        Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="CLOSE"
                    Click="CloseButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="95"/>
        </Grid>
    </Grid>
</Window>
